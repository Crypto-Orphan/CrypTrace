        function getApiDescription(apiKey) {
            const descriptions = {
                etherscan: 'Ethereumブロックチェーンの最も人気のあるエクスプローラー。詳細なトランザクション情報を提供。',
                polygonscan: 'Polygon専用のブロックチェーンエクスプローラー。Etherscanと同様の使いやすさ。',
                bscscan: 'Binance Smart Chain専用。BEP-20トークンやDeFiプロトコルを追跡。',
                basescan: 'Base Layer 2ネットワーク専用。Coinbase開発の高速チェーン。',
                arbiscan: 'Arbitrum Layer 2ネットワーク専用。高速で低コストなトランザクション。',
                optimistic: 'Optimism Layer 2ネットワーク専用。Ethereum互換で低コスト。',
                blockchain: 'Bitcoin専用の老舗ブロックエクスプローラー。BTCトランザクション追跡に最適。',
                solscan: 'Solana専用のブロックエクスプローラー。高速トランザクション追跡。',
                tronscan: 'Tron専用のブロックチェーンエクスプローラー。TRX・TRC20トークンを追跡。',
                blockchair: 'マルチチェーン対応のユニバーサルエクスプローラー。複数チェーンを横断検索。',
                moralis: 'Web3開発者向けのオールインワンAPI。NFT、トークン、DeFiデータも取得可能。',
                alchemy: 'エンタープライズグレードのブロックチェーンAPI。高速で信頼性が高い。'
            };
            return descriptions[apiKey] || '';
        }

        // ========================================
        // パーティクルエフェクト
        // ========================================
        const particleCanvas = document.getElementById('particles');
        const pctx = particleCanvas.getContext('2d');
        particleCanvas.width = window.innerWidth;
        particleCanvas.height = window.innerHeight;

        const particles = [];
        const particleCount = 50;

        class Particle {
            constructor() {
                this.x = Math.random() * particleCanvas.width;
                this.y = Math.random() * particleCanvas.height;
                this.size = Math.random() * 4 + 3;
                this.speedX = Math.random() * 2 - 1;
                this.speedY = Math.random() * 2 - 1;
                this.opacity = Math.random() * 0.5 + 0.3;
                this.color = ['#00ffff', '#ff00ff', '#00ff88', '#ff0088'][Math.floor(Math.random() * 4)];
            }

            update() {
                this.x += this.speedX;
                this.y += this.speedY;

                if (this.x > particleCanvas.width) this.x = 0;
                if (this.x < 0) this.x = particleCanvas.width;
                if (this.y > particleCanvas.height) this.y = 0;
                if (this.y < 0) this.y = particleCanvas.height;
            }

            draw() {
                pctx.fillStyle = this.color;
                pctx.globalAlpha = this.opacity;
                pctx.beginPath();
                pctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
                pctx.fill();
            }
        }

        for (let i = 0; i < particleCount; i++) {
            particles.push(new Particle());
        }

        function animateParticles() {
            pctx.clearRect(0, 0, particleCanvas.width, particleCanvas.height);
            
            for (let i = 0; i < particles.length; i++) {
                particles[i].update();
                particles[i].draw();

                for (let j = i + 1; j < particles.length; j++) {
                    const dx = particles[i].x - particles[j].x;
                    const dy = particles[i].y - particles[j].y;
                    const distance = Math.sqrt(dx * dx + dy * dy);

                    if (distance < 150) {
                        pctx.strokeStyle = particles[i].color;
                        pctx.globalAlpha = 0.1 * (1 - distance / 150);
                        pctx.lineWidth = 1;
                        pctx.beginPath();
                        pctx.moveTo(particles[i].x, particles[i].y);
                        pctx.lineTo(particles[j].x, particles[j].y);
                        pctx.stroke();
                    }
                }
            }

            requestAnimationFrame(animateParticles);
        }

        animateParticles();

        // ========================================
        // マインドマップ描画
        // ========================================
        const canvas = document.getElementById('mindmapCanvas');
        const ctx = canvas.getContext('2d');
        canvas.width = canvas.offsetWidth;
        canvas.height = canvas.offsetHeight;

        let nodes = [];
        let edges = [];
        let offsetX = 0;
        let offsetY = 0;
        let isDragging = false;
        let lastX = 0;
        let lastY = 0;
        let scale = 1;

        class Node {
            constructor(address, x, y, chain, tokenType, level = 0, balance = null) {
                this.address = address;
                this.x = x;
                this.y = y;
                this.chain = chain;
                this.tokenType = tokenType;
                this.level = level;
                this.balance = balance || (Math.random() * 100).toFixed(4);
                this.txCount = Math.floor(Math.random() * 1000);
                this.radius = 30;
                this.color = this.getColor();
                this.label = this.formatAddress(address);
            }

            getColor() {
                if (this.tokenType === 'usdt') return chainColors.usdt;
                if (this.tokenType === 'usdc') return chainColors.usdc;
                return customChains[this.chain]?.color || chainColors[this.chain] || chainColors.other;
            }

            formatAddress(addr) {
                if (addr.length > 12) {
                    return addr.substring(0, 6) + '...' + addr.substring(addr.length - 4);
                }
                return addr;
            }

            draw() {
                const screenX = this.x * scale + offsetX;
                const screenY = this.y * scale + offsetY;

                ctx.shadowBlur = 20;
                ctx.shadowColor = this.color;

                ctx.beginPath();
                ctx.arc(screenX, screenY, this.radius * scale, 0, Math.PI * 2);
                ctx.fillStyle = `rgba(${this.hexToRgb(this.color)}, 0.3)`;
                ctx.fill();
                ctx.strokeStyle = this.color;
                ctx.lineWidth = 3;
                ctx.stroke();

                ctx.shadowBlur = 0;

                ctx.fillStyle = '#ffffff';
                ctx.font = `${12 * scale}px sans-serif`;
                ctx.textAlign = 'center';
                ctx.fillText(this.label, screenX, screenY + this.radius * scale + 20);
            }

            hexToRgb(hex) {
                const r = parseInt(hex.slice(1, 3), 16);
                const g = parseInt(hex.slice(3, 5), 16);
                const b = parseInt(hex.slice(5, 7), 16);
                return `${r}, ${g}, ${b}`;
            }

            isPointInside(x, y) {
                const screenX = this.x * scale + offsetX;
                const screenY = this.y * scale + offsetY;
                const distance = Math.sqrt((x - screenX) ** 2 + (y - screenY) ** 2);
                return distance < this.radius * scale;
            }
        }

        class Edge {
            constructor(from, to) {
                this.from = from;
                this.to = to;
            }

            draw() {
                const fromX = this.from.x * scale + offsetX;
                const fromY = this.from.y * scale + offsetY;
                const toX = this.to.x * scale + offsetX;
                const toY = this.to.y * scale + offsetY;

                ctx.beginPath();
                ctx.moveTo(fromX, fromY);
                ctx.lineTo(toX, toY);
                ctx.strokeStyle = `rgba(0, 255, 255, 0.3)`;
                ctx.lineWidth = 2;
                ctx.stroke();

                const angle = Math.atan2(toY - fromY, toX - fromX);
                const arrowLength = 15;
                ctx.beginPath();
                ctx.moveTo(toX, toY);
                ctx.lineTo(
                    toX - arrowLength * Math.cos(angle - Math.PI / 6),
                    toY - arrowLength * Math.sin(angle - Math.PI / 6)
                );
                ctx.lineTo(
                    toX - arrowLength * Math.cos(angle + Math.PI / 6),
                    toY - arrowLength * Math.sin(angle + Math.PI / 6)
                );
                ctx.closePath();
                ctx.fillStyle = `rgba(0, 255, 255, 0.5)`;
                ctx.fill();
            }
        }

        function drawMindmap() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            edges.forEach(edge => edge.draw());
            nodes.forEach(node => node.draw());
        }

        // ========================================
        // API連携関数（次のステップで実装）
        // ========================================
        async function fetchTransactionsFromAPI(address, chain, tokenType) {
            // TODO: 実際のAPI呼び出しを実装
            // この部分は次のステップで詳しく説明します
            console.log('API呼び出し:', { address, chain, tokenType });
            
            // 現在はデモデータを返す
            return generateDemoData(address, chain, tokenType);
        }

        function generateDemoData(address, chain, tokenType) {
            nodes = [];
            edges = [];

            const centerX = canvas.width / 2;
            const centerY = canvas.height / 2;

            const centerNode = new Node(address, centerX, centerY, chain, tokenType, 0);
            nodes.push(centerNode);

            const angleStep = (Math.PI * 2) / 6;
            const radius = 200;

            for (let i = 0; i < 6; i++) {
                const angle = angleStep * i;
                const x = centerX + Math.cos(angle) * radius;
                const y = centerY + Math.sin(angle) * radius;
                
                const subAddress = '0x' + Math.random().toString(16).substring(2, 42);
                const subNode = new Node(subAddress, x, y, chain, tokenType, 1);
                nodes.push(subNode);
                edges.push(new Edge(centerNode, subNode));

                if (i < 3) {
                    const subAngleStep = (Math.PI * 2) / 4;
                    const subRadius = 150;
                    
                    for (let j = 0; j < 3; j++) {
                        const subAngle = angle + subAngleStep * j - Math.PI / 2;
                        const subX = x + Math.cos(subAngle) * subRadius;
                        const subY = y + Math.sin(subAngle) * subRadius;
                        
                        const subSubAddress = '0x' + Math.random().toString(16).substring(2, 42);
                        const subSubNode = new Node(subSubAddress, subX, subY, chain, tokenType, 2);
                        nodes.push(subSubNode);
                        edges.push(new Edge(subNode, subSubNode));
                    }
                }
            }

            drawMindmap();
        }

        // ========================================
        // イベントハンドラー
        // ========================================

        // チェーン選択変更時
        document.getElementById('chainSelect').addEventListener('change', updateTokenSelectVisibility);

        // Canvas操作
        canvas.addEventListener('mousedown', (e) => {
            isDragging = true;
            lastX = e.clientX;
            lastY = e.clientY;
        });

        canvas.addEventListener('mousemove', (e) => {
            if (isDragging) {
                const deltaX = e.clientX - lastX;
                const deltaY = e.clientY - lastY;
                offsetX += deltaX;
                offsetY += deltaY;
                lastX = e.clientX;
                lastY = e.clientY;
                drawMindmap();
            }
        });

        canvas.addEventListener('mouseup', () => {
            isDragging = false;
        });

        canvas.addEventListener('click', (e) => {
            if (!isDragging) {
                const rect = canvas.getBoundingClientRect();
                const x = e.clientX - rect.left;
                const y = e.clientY - rect.top;

                nodes.forEach(node => {
                    if (node.isPointInside(x, y)) {
                        showInfoPanel(node);
                    }
                });
            }
        });

        canvas.addEventListener('wheel', (e) => {
            e.preventDefault();
            const delta = e.deltaY > 0 ? 0.9 : 1.1;
            scale *= delta;
            scale = Math.max(0.3, Math.min(scale, 3));
            drawMindmap();
        });

        function showInfoPanel(node) {
            const panel = document.getElementById('infoPanel');
            const content = document.getElementById('infoPanelContent');

            content.innerHTML = `
                <div class="info-item">
                    <span class="info-label">アドレス</span>
                    <div class="info-value">${node.address}</div>
                </div>
                <div class="info-item">
                    <span class="info-label">チェーン</span>
                    <div class="info-value">${node.chain.toUpperCase()}</div>
                </div>
                <div class="info-item">
                    <span class="info-label">トークン種別</span>
                    <div class="info-value">${node.tokenType.toUpperCase()}</div>
                </div>
                <div class="info-item">
                    <span class="info-label">残高</span>
                    <div class="info-value">${node.balance} ${node.tokenType.toUpperCase()}</div>
                </div>
                <div class="info-item">
                    <span class="info-label">トランザクション数</span>
                    <div class="info-value">${node.txCount} 件</div>
                </div>
                <div class="info-item">
                    <span class="info-label">最終更新</span>
                    <div class="info-value">${new Date().toLocaleString('ja-JP')}</div>
                </div>
                <button class="explore-btn" onclick="exploreFromNode('${node.address}', '${node.chain}', '${node.tokenType}')">
                    🔍 このアドレスから探索
                </button>
            `;

            panel.classList.add('show');
        }

        document.getElementById('closeBtn').addEventListener('click', () => {
            document.getElementById('infoPanel').classList.remove('show');
        });

        document.getElementById('exploreBtn').addEventListener('click', async () => {
            const address = document.getElementById('addressInput').value;
            const chain = document.getElementById('chainSelect').value;
            const token = document.getElementById('tokenSelect').value;

            if (!address) {
                alert('アドレスを入力してください');
                return;
            }

            if (!currentApiConfig.provider) {
                alert('API設定を行ってください');
                document.getElementById('apiModal').classList.add('show');
                return;
            }

            document.getElementById('loading').classList.add('show');
            
            try {
                await fetchTransactionsFromAPI(address, chain, token);
            } catch (error) {
                alert('エラーが発生しました: ' + error.message);
            } finally {
                document.getElementById('loading').classList.remove('show');
            }
        });

        window.exploreFromNode = function(address, chain, tokenType) {
            document.getElementById('infoPanel').classList.remove('show');
            document.getElementById('loading').classList.add('show');
            
            setTimeout(async () => {
                await fetchTransactionsFromAPI(address, chain, tokenType);
                document.getElementById('loading').classList.remove('show');
            }, 500);
        };

        // API設定モーダル
        document.getElementById('apiConfigBtn').addEventListener('click', () => {
            renderApiGrid();
            document.getElementById('apiModal').classList.add('show');
        });

        document.getElementById('apiModalClose').addEventListener('click', () => {
            document.getElementById('apiModal').classList.remove('show');
        });

        document.getElementById('apiCancelBtn').addEventListener('click', () => {
            document.getElementById('apiModal').classList.remove('show');
        });

        document.getElementById('apiSaveBtn').addEventListener('click', () => {
            if (!selectedApi) {
                alert('APIを選択してください');
                return;
            }

            const config = apiConfigs[selectedApi];
            const key = document.getElementById('apiKeyInput').value.trim();
            
            if (config.needsKey && !key) {
                alert('このAPIにはAPIキーが必要です');
                return;
            }

            currentApiConfig = {
                name: config.name,
                provider: selectedApi,
                key: key || null
            };

            // ローカルストレージに保存
            localStorage.setItem('apiConfig', JSON.stringify(currentApiConfig));

            document.getElementById('currentApi').textContent = currentApiConfig.name;
            document.getElementById('apiModal').classList.remove('show');
            
            alert(`${currentApiConfig.name} の設定が完了しました！`);
        });

        // チェーン追加モーダル
        document.getElementById('addChainBtn').addEventListener('click', () => {
            document.getElementById('addChainModal').classList.add('show');
        });

        document.getElementById('addChainModalClose').addEventListener('click', () => {
            document.getElementById('addChainModal').classList.remove('show');
        });

        document.getElementById('addChainCancelBtn').addEventListener('click', () => {
            document.getElementById('addChainModal').classList.remove('show');
        });

        document.getElementById('addChainSaveBtn').addEventListener('click', () => {
            const name = document.getElementById('customChainName').value.trim();
            const id = document.getElementById('customChainId').value.trim().toLowerCase();
            const api = document.getElementById('customChainApi').value.trim();
            const color = document.getElementById('customChainColor').value;

            if (!name || !id || !api) {
                alert('すべての項目を入力してください');
                return;
            }

            // カスタムチェーンを追加
            customChains[id] = { name, api, color };
            localStorage.setItem('customChains', JSON.stringify(customChains));

            // セレクトボックスに追加
            const select = document.getElementById('chainSelect');
            const option = document.createElement('option');
            option.value = id;
            option.textContent = `${name} (Custom)`;
            select.appendChild(option);

            // 凡例を更新
            initializeLegend();

            document.getElementById('addChainModal').classList.remove('show');
            alert(`${name} を追加しました！`);
        });

        // PDF出力
        document.getElementById('exportPdfBtn').addEventListener('click', () => {
            if (nodes.length === 0) {
                alert('まずアドレスを探索してください');
                return;
            }

            const exportData = {
                nodes: nodes.map(node => ({
                    address: node.address,
                    chain: node.chain,
                    tokenType: node.tokenType,
                    balance: node.balance,
                    txCount: node.txCount,
                    level: node.level
                })),
                edges: edges.map(edge => ({
                    from: edge.from.address,
                    to: edge.to.address
                })),
                metadata: {
                    exportDate: new Date().toISOString(),
                    apiUsed: currentApiConfig.name,
                    totalNodes: nodes.length,
                    totalEdges: edges.length
                }
            };

            const dataStr = JSON.stringify(exportData, null, 2);
            const dataBlob = new Blob([dataStr], { type: 'application/json' });
            const url = URL.createObjectURL(dataBlob);
            const link = document.createElement('a');
            link.href = url;
            link.download = `blockchain_explorer_${new Date().getTime()}.json`;
            link.click();
            URL.revokeObjectURL(url);

            alert('エクスポートデータを保存しました。\ngenerate_pdf.py スクリプトでPDF化できます。');
        });

        // リサイズ対応
        window.addEventListener('resize', () => {
            canvas.width = canvas.offsetWidth;
            canvas.height = canvas.offsetHeight;
            particleCanvas.width = window.innerWidth;
            particleCanvas.height = window.innerHeight;
            drawMindmap();
        });

        // ========================================
        // 初期化
        // ========================================
        
        // 保存されたAPI設定を復元
        const savedApiConfig = localStorage.getItem('apiConfig');
        if (savedApiConfig) {
            currentApiConfig = JSON.parse(savedApiConfig);
            document.getElementById('currentApi').textContent = currentApiConfig.name;
        }

        // カスタムチェーンを復元
        Object.entries(customChains).forEach(([id, config]) => {
            const select = document.getElementById('chainSelect');
            const option = document.createElement('option');
            option.value = id;
            option.textContent = `${config.name} (Custom)`;
            select.appendChild(option);
        });

        // 初期化
        initializeLegend();
        updateTokenSelectVisibility();
        
        // 初期デモデータ
        generateDemoData('0x742d35Cc6634C0532925a3b844Bc9e7595f0bEb', 'ethereum', 'native');
    </script>
