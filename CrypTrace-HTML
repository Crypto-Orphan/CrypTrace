        function renderApiGrid() {
            const apiGrid = document.getElementById('apiGrid');
            apiGrid.innerHTML = Object.entries(apiConfigs).map(([key, config]) => `
                <div class="api-card" data-api="${key}">
                    <div class="api-card-title">${config.name}</div>
