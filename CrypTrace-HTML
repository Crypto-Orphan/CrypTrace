                    <span>USDT</span>
                </div>
                <div class="legend-item">
                    <div class="legend-color" style="background: ${chainColors.usdc};"></div>
                    <span>USDC</span>
                </div>
                <div class="legend-item">
                    <div class="legend-color" style="background: ${chainColors.other};"></div>
                    <span>その他トークン</span>
