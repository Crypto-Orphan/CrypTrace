<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CrypTrace</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', 'Yu Gothic', 'Meiryo', sans-serif;
            background: linear-gradient(135deg, #0a0a0f 0%, #1a1a2e 50%, #16213e 100%);
            color: #e0e0e0;
            overflow: hidden;
            height: 100vh;
        }

        #particles {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 1;
        }

        .container {
            position: relative;
            z-index: 2;
            height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .header {
            background: rgba(15, 15, 25, 0.9);
            backdrop-filter: blur(10px);
            padding: 20px;
            border-bottom: 2px solid rgba(0, 255, 255, 0.3);
            box-shadow: 0 4px 20px rgba(0, 255, 255, 0.1);
        }

        .header h1 {
            font-size: clamp(20px, 4vw, 28px);
            background: linear-gradient(90deg, #00ffff, #ff00ff);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            margin-bottom: 15px;
            text-align: center;
        }

        .input-section {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            justify-content: center;
            align-items: center;
        }

        .input-group {
            display: flex;
            flex-direction: column;
            gap: 5px;
        }

        .input-group label {
            font-size: 12px;
            color: #00ffff;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        input, select {
            padding: 12px 15px;
            background: rgba(30, 30, 45, 0.8);
            border: 1px solid rgba(0, 255, 255, 0.3);
            border-radius: 8px;
            color: #e0e0e0;
            font-size: 14px;
            transition: all 0.3s;
            min-width: 200px;
        }

        input:focus, select:focus {
            outline: none;
            border-color: #00ffff;
            box-shadow: 0 0 15px rgba(0, 255, 255, 0.3);
        }

        button {
            padding: 12px 30px;
            background: linear-gradient(135deg, #00ffff, #0088ff);
            border: none;
            border-radius: 8px;
            color: #000;
            font-weight: bold;
            font-size: 14px;
            cursor: pointer;
            transition: all 0.3s;
            text-transform: uppercase;
            letter-spacing: 1px;
            box-shadow: 0 4px 15px rgba(0, 255, 255, 0.3);
        }

        button:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(0, 255, 255, 0.5);
        }

        button:active {
            transform: translateY(0);
        }

        button:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        .api-config-btn {
            background: linear-gradient(135deg, #ff00ff, #ff0088);
            padding: 10px 20px;
            font-size: 12px;
        }

        .export-pdf-btn {
            background: linear-gradient(135deg, #00ff88, #00cc66);
            padding: 10px 20px;
            font-size: 12px;
        }

        .add-chain-btn {
            background: linear-gradient(135deg, #ffaa00, #ff6600);
            padding: 10px 20px;
            font-size: 12px;
        }

        .canvas-container {
            flex: 1;
            position: relative;
            overflow: hidden;
        }

        #mindmapCanvas {
            width: 100%;
            height: 100%;
            cursor: grab;
        }

        #mindmapCanvas:active {
            cursor: grabbing;
        }

        /* モーダル共通スタイル */
        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.85);
            z-index: 1000;
            justify-content: center;
            align-items: center;
        }

        .modal.show {
            display: flex;
            animation: fadeIn 0.3s ease-out;
        }

        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }

        .modal-content {
            background: rgba(15, 15, 25, 0.98);
            border: 2px solid rgba(0, 255, 255, 0.5);
            border-radius: 16px;
            padding: 30px;
            max-width: 900px;
            max-height: 90vh;
            overflow-y: auto;
            box-shadow: 0 10px 50px rgba(0, 255, 255, 0.3);
            animation: slideUp 0.3s ease-out;
        }

        @keyframes slideUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .modal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
            padding-bottom: 15px;
            border-bottom: 1px solid rgba(0, 255, 255, 0.3);
        }

        .modal-title {
            font-size: 24px;
            background: linear-gradient(90deg, #00ffff, #ff00ff);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .modal-close {
            background: rgba(255, 0, 100, 0.8);
            border: none;
            color: white;
            width: 35px;
            height: 35px;
            border-radius: 50%;
            cursor: pointer;
            font-size: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s;
            padding: 0;
        }

        .modal-close:hover {
            background: rgba(255, 0, 100, 1);
            transform: rotate(90deg);
        }

        /* API選択モーダル */
        .api-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
            margin-bottom: 20px;
        }

        .api-card {
            background: rgba(30, 30, 45, 0.8);
            border: 2px solid rgba(0, 255, 255, 0.3);
            border-radius: 12px;
            padding: 20px;
            cursor: pointer;
            transition: all 0.3s;
        }

        .api-card:hover {
            border-color: #00ffff;
            box-shadow: 0 5px 20px rgba(0, 255, 255, 0.3);
            transform: translateY(-3px);
        }

        .api-card.selected {
            border-color: #00ff88;
            background: rgba(0, 255, 136, 0.1);
        }

        .api-card-title {
            font-size: 18px;
            font-weight: bold;
            color: #00ffff;
            margin-bottom: 10px;
        }

        .api-card-chains {
            font-size: 12px;
            color: #ff00ff;
            margin-bottom: 10px;
        }

        .api-card-desc {
            font-size: 13px;
            color: #e0e0e0;
            line-height: 1.5;
        }

        .api-card-status {
            margin-top: 10px;
            padding: 5px 10px;
            border-radius: 5px;
            font-size: 11px;
            display: inline-block;
        }

        .status-free {
            background: rgba(0, 255, 136, 0.2);
            color: #00ff88;
        }

        .status-paid {
            background: rgba(255, 136, 0, 0.2);
            color: #ff8800;
        }

        .api-key-section {
            margin-top: 25px;
            padding: 20px;
            background: rgba(30, 30, 45, 0.6);
            border-radius: 8px;
            border: 1px solid rgba(0, 255, 255, 0.2);
        }

        .api-key-section h3 {
            color: #00ffff;
            margin-bottom: 15px;
            font-size: 16px;
        }

        .api-key-input {
            width: 100%;
            margin-bottom: 10px;
        }

        .modal-actions {
            display: flex;
            gap: 15px;
            justify-content: flex-end;
            margin-top: 25px;
        }

        .btn-cancel {
            background: rgba(100, 100, 120, 0.8);
            color: #e0e0e0;
        }

        .btn-save {
            background: linear-gradient(135deg, #00ff88, #00cc66);
        }

        .info-panel {
            position: absolute;
            top: 20px;
            right: 20px;
            background: rgba(15, 15, 25, 0.95);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(0, 255, 255, 0.3);
            border-radius: 12px;
            padding: 20px;
            max-width: 350px;
            max-height: 80vh;
            overflow-y: auto;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5);
            display: none;
            z-index: 10;
        }

        .info-panel.show {
            display: block;
            animation: slideIn 0.3s ease-out;
        }

        @keyframes slideIn {
            from {
                opacity: 0;
                transform: translateX(20px);
            }
            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        .info-panel h3 {
            color: #00ffff;
            margin-bottom: 15px;
            font-size: 18px;
            border-bottom: 1px solid rgba(0, 255, 255, 0.3);
            padding-bottom: 10px;
        }

        .info-item {
            margin-bottom: 12px;
            font-size: 13px;
        }

        .info-label {
            color: #ff00ff;
            font-weight: bold;
            display: block;
            margin-bottom: 4px;
        }

        .info-value {
            color: #e0e0e0;
            word-break: break-all;
            background: rgba(30, 30, 45, 0.6);
            padding: 8px;
            border-radius: 6px;
            border-left: 3px solid #00ffff;
        }

        .close-btn {
            position: absolute;
            top: 10px;
            right: 10px;
            background: rgba(255, 0, 100, 0.8);
            border: none;
            color: white;
            width: 30px;
            height: 30px;
            border-radius: 50%;
            cursor: pointer;
            font-size: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s;
        }

        .close-btn:hover {
            background: rgba(255, 0, 100, 1);
            transform: rotate(90deg);
        }

        .explore-btn {
            margin-top: 15px;
            width: 100%;
            padding: 10px;
            background: linear-gradient(135deg, #ff00ff, #ff0088);
            font-size: 12px;
        }

        .legend {
            position: absolute;
            bottom: 20px;
            left: 20px;
            background: rgba(15, 15, 25, 0.9);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(0, 255, 255, 0.3);
            border-radius: 8px;
            padding: 15px;
            z-index: 10;
            max-height: 300px;
            overflow-y: auto;
        }

        .legend-title {
            color: #00ffff;
            font-size: 14px;
            font-weight: bold;
            margin-bottom: 10px;
        }

        .legend-item {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 8px;
            font-size: 12px;
        }

        .legend-color {
            width: 20px;
            height: 20px;
            border-radius: 4px;
            border: 1px solid rgba(255, 255, 255, 0.3);
        }

        .loading {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            text-align: center;
            display: none;
            background: rgba(15, 15, 25, 0.95);
            padding: 30px;
            border-radius: 12px;
            border: 2px solid rgba(0, 255, 255, 0.5);
        }

        .loading.show {
            display: block;
        }

        .spinner {
            width: 50px;
            height: 50px;
            border: 4px solid rgba(0, 255, 255, 0.3);
            border-top-color: #00ffff;
            border-radius: 50%;
            animation: spin 1s linear infinite;
            margin: 0 auto;
        }

        @keyframes spin {
            to { transform: rotate(360deg); }
        }

        .loading-text {
            margin-top: 15px;
            color: #00ffff;
            font-size: 14px;
        }

        .api-status-badge {
            position: absolute;
            top: 70px;
            left: 20px;
            background: rgba(15, 15, 25, 0.9);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(0, 255, 255, 0.3);
            border-radius: 8px;
            padding: 10px 15px;
            font-size: 12px;
            z-index: 10;
        }

        .api-status-badge .status-label {
            color: #00ffff;
            font-weight: bold;
        }

        .api-status-badge .status-value {
            color: #00ff88;
        }

        .tutorial-box {
            background: rgba(255, 136, 0, 0.1);
            border: 1px solid rgba(255, 136, 0, 0.5);
            border-radius: 8px;
            padding: 15px;
            margin-bottom: 20px;
        }

        .tutorial-box h4 {
            color: #ffaa00;
            margin-bottom: 10px;
        }

        .tutorial-box p {
            color: #e0e0e0;
            font-size: 13px;
            line-height: 1.6;
        }

        .tutorial-box ol {
            margin-left: 20px;
            margin-top: 10px;
        }

        .tutorial-box li {
            color: #e0e0e0;
            font-size: 13px;
            margin-bottom: 5px;
        }

        @media (max-width: 768px) {
            .header {
                padding: 15px;
            }

            .input-section {
                flex-direction: column;
            }

            input, select {
                min-width: 100%;
            }

            .info-panel {
                max-width: calc(100% - 40px);
                right: 20px;
                left: 20px;
            }

            .legend {
                bottom: 10px;
                left: 10px;
                font-size: 11px;
            }

            .api-grid {
                grid-template-columns: 1fr;
            }

            .modal-content {
                margin: 20px;
                max-width: calc(100% - 40px);
            }
        }

        ::-webkit-scrollbar {
            width: 8px;
        }

        ::-webkit-scrollbar-track {
            background: rgba(30, 30, 45, 0.5);
        }

        ::-webkit-scrollbar-thumb {
            background: rgba(0, 255, 255, 0.5);
            border-radius: 4px;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: rgba(0, 255, 255, 0.7);
        }
    </style>
</head>
<body>
    <canvas id="particles"></canvas>
    
    <div class="container">
        <div class="header">
            <h1>🔗 ブロックチェーンエクスプローラー Pro</h1>
            <div class="input-section">
                <div class="input-group">
                    <label>通貨種別</label>
                    <select id="chainSelect">
                        <option value="ethereum">Ethereum (ETH)</option>
                        <option value="bitcoin">Bitcoin (BTC)</option>
                        <option value="polygon">Polygon (MATIC)</option>
                        <option value="bsc">Binance Smart Chain (BSC)</option>
                        <option value="arbitrum">Arbitrum</option>
                        <option value="optimism">Optimism</option>
                        <option value="base">Base</option>
                        <option value="solana">Solana (SOL)</option>
                        <option value="tron">Tron (TRX)</option>
                    </select>
                </div>
                <div class="input-group">
                    <label>アドレス / トランザクションハッシュ</label>
                    <input type="text" id="addressInput" placeholder="0x... or bc1...">
                </div>
                <div class="input-group" id="tokenSelectGroup">
                    <label>トークン種別</label>
                    <select id="tokenSelect">
                        <option value="native">ネイティブ通貨</option>
                        <option value="usdt">USDT</option>
                        <option value="usdc">USDC</option>
                        <option value="all">全てのトークン</option>
                    </select>
                </div>
                <button id="exploreBtn">🔍 探索開始</button>
                <button class="api-config-btn" id="apiConfigBtn">⚙️ API設定</button>
                <button class="add-chain-btn" id="addChainBtn">➕ チェーン追加</button>
                <button class="export-pdf-btn" id="exportPdfBtn">📄 PDF出力</button>
            </div>
        </div>

        <div class="canvas-container">
            <canvas id="mindmapCanvas"></canvas>
            
            <div class="loading" id="loading">
                <div class="spinner"></div>
                <div class="loading-text">トランザクションを読み込み中...</div>
            </div>

            <div class="api-status-badge">
                <span class="status-label">API: </span>
                <span class="status-value" id="currentApi">未設定</span>
            </div>

            <div class="info-panel" id="infoPanel">
                <button class="close-btn" id="closeBtn">×</button>
                <h3>📊 アドレス情報</h3>
                <div id="infoPanelContent"></div>
            </div>

            <div class="legend">
                <div class="legend-title">🎨 凡例</div>
                <div id="legendContent"></div>
            </div>
        </div>
    </div>

    <!-- API設定モーダル -->
    <div class="modal" id="apiModal">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title">⚙️ API設定</h2>
                <button class="modal-close" id="apiModalClose">×</button>
            </div>

            <div class="tutorial-box">
                <h4>📖 初めての方へ - APIキーの取得方法</h4>
                <p><strong>Etherscan (Ethereum用):</strong></p>
                <ol>
                    <li>https://etherscan.io/ にアクセス</li>
                    <li>「Sign In」→「Sign Up」でアカウント作成（無料）</li>
                    <li>メール認証後、ログイン</li>
                    <li>「API Keys」タブ → 「Add」ボタンでキー作成</li>
                    <li>表示されたキーをコピーして下の入力欄に貼り付け</li>
                </ol>
                <p style="margin-top: 10px;"><strong>💡 ヒント:</strong> まずはEtherscanから始めるのがおすすめです！</p>
            </div>
            
            <div class="api-grid" id="apiGrid"></div>

            <div class="api-key-section">
                <h3>🔑 APIキー設定</h3>
                <p style="color: #aaa; font-size: 12px; margin-bottom: 15px;">
                    選択したAPIサービスのAPIキーを入力してください。<br>
                    各サービスの公式サイトで無料アカウントを作成することで取得できます。
                </p>
                <input type="text" class="api-key-input" id="apiKeyInput" placeholder="APIキーを入力 (例: YOUR_API_KEY_HERE)">
            </div>

            <div class="modal-actions">
                <button class="btn-cancel" id="apiCancelBtn">キャンセル</button>
                <button class="btn-save" id="apiSaveBtn">保存して適用</button>
            </div>
        </div>
    </div>

    <!-- チェーン追加モーダル -->
    <div class="modal" id="addChainModal">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title">➕ カスタムチェーン追加</h2>
                <button class="modal-close" id="addChainModalClose">×</button>
            </div>

            <div class="tutorial-box">
                <h4>📖 カスタムチェーンの追加方法</h4>
                <p>独自のブロックチェーンやテストネットを追加できます。</p>
                <p style="margin-top: 10px;"><strong>必要な情報:</strong></p>
                <ul style="margin-left: 20px; margin-top: 5px;">
                    <li>チェーン名（例: Avalanche, Fantom）</li>
                    <li>チェーンID（任意の識別子）</li>
                    <li>APIエンドポイントURL</li>
                    <li>表示カラー（16進数）</li>
                </ul>
            </div>

            <div style="display: grid; gap: 15px; margin: 20px 0;">
                <div class="input-group">
                    <label>チェーン名</label>
                    <input type="text" id="customChainName" placeholder="例: Avalanche">
                </div>
                <div class="input-group">
                    <label>チェーンID（英数字のみ）</label>
                    <input type="text" id="customChainId" placeholder="例: avalanche">
                </div>
                <div class="input-group">
                    <label>APIエンドポイント</label>
                    <input type="text" id="customChainApi" placeholder="例: https://api.snowtrace.io/api">
                </div>
                <div class="input-group">
                    <label>表示カラー</label>
                    <input type="color" id="customChainColor" value="#e84142">
                </div>
            </div>

            <div class="modal-actions">
                <button class="btn-cancel" id="addChainCancelBtn">キャンセル</button>
                <button class="btn-save" id="addChainSaveBtn">追加</button>
            </div>
        </div>
    </div>

    <script>
        // ========================================
        // グローバル変数
        // ========================================
        let selectedApi = null;
        let apiKey = null;
        let currentApiConfig = {
            name: '未設定',
            provider: null,
            key: null
        };

        // カスタムチェーンを保存
        let customChains = JSON.parse(localStorage.getItem('customChains') || '{}');

        // ========================================
        // チェーンとAPIの設定
        // ========================================
        const chainColors = {
            ethereum: '#00ffff',
            bitcoin: '#ff9500',
            polygon: '#8247e5',
            bsc: '#f0b90b',
            arbitrum: '#28a0f0',
            optimism: '#ff0420',
            base: '#0052ff',
            solana: '#14f195',
            tron: '#ff0013',
            usdt: '#26a17b',
            usdc: '#2775ca',
            other: '#ff00ff'
        };

        // Bitcoin系チェーン（トークン選択不可）
        const utxoChains = ['bitcoin'];

        const apiConfigs = {
            etherscan: {
                name: 'Etherscan',
                chains: ['ethereum'],
                baseUrl: 'https://api.etherscan.io/api',
                docs: 'https://docs.etherscan.io/',
                needsKey: true
            },
            polygonscan: {
                name: 'PolygonScan',
                chains: ['polygon'],
                baseUrl: 'https://api.polygonscan.com/api',
                docs: 'https://docs.polygonscan.com/',
                needsKey: true
            },
            bscscan: {
                name: 'BscScan',
                chains: ['bsc'],
                baseUrl: 'https://api.bscscan.com/api',
                docs: 'https://docs.bscscan.com/',
                needsKey: true
            },
            basescan: {
                name: 'BaseScan',
                chains: ['base'],
                baseUrl: 'https://api.basescan.org/api',
                docs: 'https://docs.basescan.org/',
                needsKey: true
            },
            arbiscan: {
                name: 'Arbiscan',
                chains: ['arbitrum'],
                baseUrl: 'https://api.arbiscan.io/api',
                docs: 'https://docs.arbiscan.io/',
                needsKey: true
            },
            optimistic: {
                name: 'Optimistic Etherscan',
                chains: ['optimism'],
                baseUrl: 'https://api-optimistic.etherscan.io/api',
                docs: 'https://docs.optimism.etherscan.io/',
                needsKey: true
            },
            blockchain: {
                name: 'Blockchain.com',
                chains: ['bitcoin'],
                baseUrl: 'https://blockchain.info',
                docs: 'https://www.blockchain.com/api',
                needsKey: false
            },
            solscan: {
                name: 'Solscan',
                chains: ['solana'],
                baseUrl: 'https://public-api.solscan.io',
                docs: 'https://docs.solscan.io/',
                needsKey: false
            },
            tronscan: {
                name: 'TronScan',
                chains: ['tron'],
